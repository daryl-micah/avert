{
  "name": "avert-mcp",
  "version": "0.1.0",
  "description": "Knows every external API your code calls, sees when a provider changes one, traces what it breaks.",
  "keywords": [
    "mcp",
    "falkordb",
    "api-changes",
    "deprecation",
    "sdk",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daryl-micah/avert.git"
  },
  "homepage": "https://avert-agent.vercel.app",
  "bugs": {
    "url": "https://github.com/daryl-micah/avert/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "avert": "dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "avert": "tsx src/cli.ts",
    "build": "tsc -p . && cp src/web/index.html dist/web/",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "docs:gen": "tsx scripts/gen-docs.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "falkordb": "^6.8.0",
    "hono": "^4.13.13",
    "openai": "^7.34.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
